{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "degen-paper-trader",
  "main": "worker.js",
  "compatibility_date": "2026-10-05",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "degen-paper-trader-db",
      "database_id": "3beba0cd-b62a-4331-966f-5619863b9bf3"
    }
  ],

  // PNG PnL cards (Cloudflare Browser Rendering). No API token needed.
  "browser": {
    "binding": "BROWSER"
  },

  // Automatic Take Profit monitor, runs every minute.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // Optional: base URL of your real mascot artwork.
  // Files are loaded as <MASCOT_BASE_URL>/<mascotKey>.png
  // (rekt, devastated, down_bad, small_l, green, confident,
  //  celebrating, jumping, degen, insane, legendary, god)
  // Leave empty to use the built-in mascots.
  "vars": {
    "MASCOT_BASE_URL": ""
  },

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
